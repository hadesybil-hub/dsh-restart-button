{
  "name": "@darkthee/dsh-restart-button",
  "version": "0.4.0",
  "description": "One-click restart button for the DeepSeek Harness Web GUI. In the Desktop app it restarts the whole application (shell + Host) and the next window is a cold start; in a CLI dsh web it restarts the server and the page reloads itself.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "plugin",
    "restart",
    "button",
    "web",
    "desktop",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hadesybil-hub/dsh-restart-button.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
